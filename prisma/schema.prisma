// Esquema de base de datos de OmniMarket Operations Hub.
// El dinero se guarda en centavos (Int) para evitar errores de redondeo.

generator client {
  provider      = "prisma-client-js"
  // "native": tu computadora y la CI. "rhel-openssl-3.0.x": los servidores de Vercel.
  // La CI compila en Ubuntu y Vercel ejecuta en Amazon Linux, así que se incluyen los dos motores.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Autenticación (modelos requeridos por Auth.js)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  store         Store?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?  @db.Text
  access_token             String?  @db.Text
  expires_at               Int?
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String?  @db.Text
  session_state            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─────────────────────────────────────────────
// E-commerce
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Cada tienda tiene sus propios productos, clientes y pedidos.
// - "Mi tienda": una por usuario (ownerId), se crea la primera vez que entra y empieza vacía.
// - Tienda de demostración: isDemo = true, sin dueño, con los datos de prueba compartidos.
model Store {
  id        String     @id @default(cuid())
  name      String
  isDemo    Boolean    @default(false)
  ownerId   String?    @unique
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  products  Product[]
  customers Customer[]
  orders    Order[]
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  sku            String
  name           String
  category       String
  priceCents     Int
  costCents      Int
  stock          Int           @default(0)
  // Cuándo se subió la foto (null = sin foto). Va en la dirección de la imagen para que el
  // navegador pida la nueva cuando cambia.
  imageUpdatedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orderItems     OrderItem[]
  image          ProductImage?
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, sku])
  @@index([storeId, category])
}

// Foto de un producto, ya reducida en el navegador (máximo 800 px, WebP o JPEG).
// Va en su propia tabla para que las consultas de productos no carguen las imágenes.
model ProductImage {
  productId String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  email     String?
  city      String
  createdAt DateTime @default(now())
  orders    Order[]
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([storeId, name])
}

model Order {
  id         String      @id @default(cuid())
  storeId    String
  number     Int         @unique @default(autoincrement())
  status     OrderStatus @default(PENDING)
  position   Int         @default(0)
  totalCents Int
  costCents  Int
  customerId String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // NoAction (diferida en la migración): un cliente con pedidos no se puede borrar solo, pero sí junto con toda su tienda.
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: NoAction)
  items    OrderItem[]
  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, position])
  @@index([storeId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int
  unitCostCents  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // NoAction (diferida en la migración): un producto en pedidos no se puede borrar solo, pero sí junto con toda su tienda.
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([orderId])
  @@index([productId])
}

// Cuándo se restablecieron por última vez los datos de prueba (una sola fila, id = 1).
// Sirve para que POST /api/test/reset-data no se pueda usar muchas veces seguidas.
model DataReset {
  id          Int      @id
  lastResetAt DateTime
}
