# Base de datos (Supabase → Connect → ORMs → Prisma)
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST:5432/postgres"

# Auth.js — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# OAuth GitHub (github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# OAuth Google (console.cloud.google.com → Google Auth Platform → Clientes)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Opcional: segundos de espera entre reinicios de POST /api/test/reset-data
# (si no se pone: 15 en producción, 0 en desarrollo; la CI usa 0).
# RESET_COOLDOWN_SECONDS=15
